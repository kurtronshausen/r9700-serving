# Our own RTN W4A16 group-128 quant of Qwen3.8-27B-FP8 (see
# tools/quant_qwen38.py) — all main-layer linears (self_attn q/k/v/o,
# linear_attn in_proj_qkv/z/out_proj, mlp gate/up/down) int4/group-128;
# mtp.*, visual.*, embeds, norms, and GDN small-state tensors stay BF16.
# 19 GiB on disk (~4.9 GiB/GPU at TP4) vs 27 GiB for the FP8 original.
#
# Served by the `vllm-w4` compose service (port ${W4_PORT:-8002}) — a THIRD
# concurrent server that co-locates with the main 27b (0.53 util): 0.53 + 0.35
# = 0.88 of VRAM. Purpose: a smaller-footprint backend that can be served
# while the flashnext W4 model (needs ~0.6 of VRAM) is brought up.
#
# Verified 2026-08-28: 400 quantized linears, 12.26% rel-RMS (same as the
# flashnext RTN baseline of 12.0%).
VLLM_MODEL=/srv/llm/kurt/qwen3.8-27b-w4a16-rtng128
VLLM_TOKENIZER=/srv/llm/kurt/qwen3.8-27b-w4a16-rtng128
VLLM_SERVED_NAME=qwen3.8-27b-w4
VLLM_TP=4
VLLM_GPU_MEM_UTIL=0.35
# 0.35 util leaves 3.82 GiB KV -> ~223k max; capped at the launcher's
# prompt budget (196608) with ~0.9 GiB slack.
VLLM_MAX_MODEL_LEN=196608
VLLM_KV_CACHE_DTYPE=bfloat16
# 1 concurrent sequence while co-located (bounds worst-case KV + narrows the
# #35288 MTP-corruption exposure).
VLLM_MAX_NUM_SEQS=1
# MTP3 spec-decode (same as the FP8 profile; mtp.* weights are BF16 here).
VLLM_SPEC_DECODE='{"method": "mtp", "num_speculative_tokens": 3, "attention_backend": "ROCM_AITER_UNIFIED_ATTN"}'
