# Model-specific config for Qwen3.8-27B-FP8 — shares kv_cache_dtype, spec_decode, tool_choice
# via env/qwen3.6.env.common.
# fp8 KV is served with calibrated q/k/v scales by default: VLLM_MODEL_ID is the
# HF source (the stock checkpoint ships no scales -> scale-1.0 fp8 KV), and
# VLLM_MODEL is a local copy generated + calibrated by `just up` ->
# ensure-kvscales (see justfile). Recalibrate with `just clear-kvscales`.
VLLM_MODEL_ID=Qwen/Qwen3.8-27B-FP8
VLLM_MODEL=/home/philip/models-local/Qwen3.8-27B-FP8-kvscales
VLLM_TOKENIZER=/home/philip/models-local/Qwen3.8-27B-FP8-kvscales
VLLM_SERVED_NAME=qwen3.8-27b
VLLM_GPU_MEM_UTIL=0.85
VLLM_MAX_MODEL_LEN=262144
# fp8 KV cache: explicit here (inherited from env/qwen3.6.env.common); halves KV
# memory so the 256K context fits.
VLLM_KV_CACHE_DTYPE=fp8
# 2 concurrent sequences: keep the #35288 cap from qwen3.6.env.common explicit.
VLLM_MAX_NUM_SEQS=2
# MTP3 spec-decode. Depth sweep 2026-08-22 (calibrated fp8 KV, v0.28.0rc2):
# MTP3 holds decode far better at depth than DFlash2 (tg32 37@d128K vs DFlash
# 15; MTP3 52@d64K vs DFlash 24), though DFlash2 wins at short context (tg32
# ~88 vs MTP3 ~62 @d0). Chosen as default for this repo's deep-context focus.
# DFlash2 rejected: see archive/DEADENDS.md.
VLLM_SPEC_DECODE='{"method": "mtp", "num_speculative_tokens": 3, "attention_backend": "ROCM_AITER_UNIFIED_ATTN"}'