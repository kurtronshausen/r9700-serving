# Model-specific config for Qwen3.8-27B-FP8 — shares kv_cache_dtype, spec_decode, tool_choice
# via env/qwen3.6.env.common.
VLLM_MODEL=Qwen/Qwen3.8-27B-FP8
VLLM_TOKENIZER=Qwen/Qwen3.8-27B-FP8
VLLM_SERVED_NAME=qwen3.8-27b
VLLM_GPU_MEM_UTIL=0.85
VLLM_MAX_MODEL_LEN=262144
# fp8 KV cache: explicit here (inherited from env/qwen3.6.env.common); halves KV
# memory so the 256K context fits.
VLLM_KV_CACHE_DTYPE=fp8
# 2 concurrent sequences: keep the #35288 cap from qwen3.6.env.common explicit.
VLLM_MAX_NUM_SEQS=2
# DFlash2 drafter (incoai/Qwen3.8-27B-DFlash2) forces V2 model runner.
# Benchmarks v0.28.0rc2: tg32 ~88 t/s (MTP3 ~62), tg128 ~78 t/s (MTP3 ~65),
# acceptance ~80% (MTP3 ~65%). DFlash2 block=8, num_spec_tokens=7.
VLLM_SPEC_DECODE='{"method": "dflash", "model": "incoai/Qwen3.8-27B-DFlash2", "num_speculative_tokens": 7, "attention_backend": "ROCM_AITER_UNIFIED_ATTN"}'