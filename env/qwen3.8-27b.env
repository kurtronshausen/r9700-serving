# Model-specific config for Qwen3.8-27B-FP8 — shares kv_cache_dtype, spec_decode,
# tool_choice, and the max_num_seqs cap via env/qwen3.6.env.common.
#
# Model is pulled from the HF hub (no local copy on this host yet). When the
# calibrated fp8 KV-scale copy is ready, point VLLM_MODEL/VLLM_TOKENIZER at the
# local directory and add VLLM_MODEL_ID (the HF source id) so the
# `just ensure-kvscales` recipe builds + calibrates it — see the fp8-KV notes
# in README.md ("Non-standard vLLM flags"). Until then the stock checkpoint
# serves fp8 KV at scale 1.0, which is why bf16 KV is the default here.
VLLM_MODEL=Qwen/Qwen3.8-27B-FP8
VLLM_TOKENIZER=Qwen/Qwen3.8-27B-FP8
VLLM_SERVED_NAME=qwen3.8-27b
# 4x R9700 host: serve on all four GPUs by default (matches the pre-entrypoint
# VLLM_TP=4 config). When running `vllm-vision` concurrently, partition at
# runtime (VLLM_TP=2 + per-container HIP_VISIBLE_DEVICES).
VLLM_TP=4
VLLM_GPU_MEM_UTIL=0.5
VLLM_MAX_MODEL_LEN=196608
# bf16 KV cache: explicit here (inherited from env/qwen3.6.env.common). Note
# bf16 doubles KV memory vs fp8 — if 256K no longer fits at this util/max-len,
# either drop VLLM_MAX_MODEL_LEN or switch back to fp8.
VLLM_KV_CACHE_DTYPE=bfloat16
# 2 concurrent sequences: keep the #35288 cap explicit here (also now the
# universal compose.yaml default). Do not raise until vllm#35288 is fixed.
VLLM_MAX_NUM_SEQS=1
# MTP3 spec-decode. Depth sweep 2026-08-22 (v0.28.0rc2; re-measured on the bf16
# KV default 2026-08-22):
# MTP3 holds decode far better at depth than DFlash2 (tg32 37@d128K vs DFlash
# 15; MTP3 52@d64K vs DFlash 24), though DFlash2 wins at short context (tg32
# ~88 vs MTP3 ~62 @d0). Chosen as default for this repo's deep-context focus.
# DFlash2 rejected: see archive/DEADENDS.md.
VLLM_SPEC_DECODE='{"method": "mtp", "num_speculative_tokens": 3, "attention_backend": "ROCM_AITER_UNIFIED_ATTN"}'
VLLM_CHAT_TEMPLATE=/app/chat-templates/qwen.jinja
# #53504 workaround (v0.28.1rc0+#52216): pin dense Mamba retention to the
# attention block size — 832 on this bf16-KV profile (identical GDN geometry
# to qwen3.6-27b; confirm the "Setting attention block size" line in the boot
# log). Without it, the sparse rc0 default breaks the first-repeat
# prefix-cache hit under MTP. Inert until VLLM_REF is bumped to v0.28.1rc0+
# (see .env.example) — entrypoint.sh only passes the flag when set.
PREFIX_CACHE_RETENTION_INTERVAL=832
