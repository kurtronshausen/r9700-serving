# Model-specific config for Qwen3.8-27B-FP8 — shares kv_cache_dtype, spec_decode, tool_choice
# via env/qwen3.6.env.common.
VLLM_MODEL=Qwen/Qwen3.8-27B-FP8
VLLM_TOKENIZER=Qwen/Qwen3.8-27B-FP8
VLLM_SERVED_NAME=qwen3.8-27b
VLLM_GPU_MEM_UTIL=0.85
# MTP3 is the 3.8 optimum (tg32: MTP3 57.6 / MTP2 56.0 / MTP4 49.2 / MTP1 45.6,
# no-MTP 32.0). The 3.8 MTP head accepts drafts poorly past position 3
# (per-position ~0.66/0.44/0.31/0.22), so more drafts waste compute and fewer
# lose throughput. The ~72% acceptance figure in the README is for Qwen3.6-27B
# (MTP4), not 3.8. Raw (no-MTP) decode is ~32 t/s on both.
VLLM_SPEC_DECODE='{"method": "mtp", "num_speculative_tokens": 3, "attention_backend": "ROCM_AITER_UNIFIED_ATTN"}'