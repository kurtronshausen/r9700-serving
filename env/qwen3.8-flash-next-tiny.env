# Smoke-test profile for the vllm-qwen-flashnext service: a tiny
# vLLM-developer-authored Qwen4ExpForCausalLM checkpoint
# (qikp/tiny-random-Qwen4-Exp_Qwen3.8-Flash-Next, 119 MB, BF16, no
# quantization). 4 layers / hidden 16 / 4 experts, but with a REAL PLE
# layer (ngram_embedding.shard_N layout, ~1.3 GiB pinned host table), so
# this exercises the full high-risk chain of the flashnext image —
# qwen4_exp AMD model path, PLE shard loading, and (with
# VLLM_PLE_CPU_OFFLOAD=1) the Triton pinned-host gather kernel on ROCm —
# at < 2 GiB VRAM. It can therefore run CONCURRENTLY with the qwen3.8-27b
# service (which holds ~18 GiB of each R9700), unlike the full W4A16
# model (~66 GiB).
#
# What it does NOT test: MoE scale, MTP, model quality or performance.
# Use the real profile (qwen3.8-flash-next.env) once the 27b stack is
# stopped or the box has the VRAM headroom.
VLLM_MODEL=/home/kurt/models/qwen3.8-flash-next-tiny
VLLM_TOKENIZER=/home/kurt/models/qwen3.8-flash-next-tiny
VLLM_SERVED_NAME=qwen3.8-flash-next-tiny
VLLM_TP=1
VLLM_GPU_MEM_UTIL=0.4
VLLM_KV_CACHE_DTYPE=bfloat16
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_BATCHED_TOKENS=2048
VLLM_MAX_NUM_SEQS=2
VLLM_PLE_CPU_OFFLOAD=1
# The tiny checkpoint lacks the MTP layer weights (hc_norm, pre_fc_norms,
# indexer layernorms), so the common profile's MTP spec-decode must be off.
VLLM_SPEC_DECODE=
# torch.compile (default mode) hits an upstream 2a4cd640 bug on this model:
# ConstraintViolationError — query_start_loc dim marked DYNAMIC by
# @support_torch_compile but specialized to a constant during warmup. The
# smoke test targets the PLE offload path, so run eager (mode 0).
VLLM_EXTRA_ARGS=--compilation-config '{"mode":0}'
# Steer the tiny server at one GPU when coexisting with the 27b service
# (all four GPUs are visible to every container).
HIP_VISIBLE_DEVICES=3
