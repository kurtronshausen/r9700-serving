# Shared config for all qwen3.6 models — only loaded when a model profile is selected.
# Per-profile overrides (model, tokenizer, served_name, batched_tokens) live in
# env/<profile>.env which is loaded last.
VLLM_KV_CACHE_DTYPE=bfloat16
VLLM_SPEC_DECODE='{"method": "mtp", "num_speculative_tokens": 4, "attention_backend": "ROCM_AITER_UNIFIED_ATTN"}'
VLLM_TOOL_CHOICE='--enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser qwen3'
# Cap concurrent sequences at 2: MTP spec-decode corrupts output when 4+ decode
# sequences share a batch (vllm-project/vllm#35288). Verified at c=1-2 healthy,
# c>=4 garbage token loops; cap keeps the batch below the trigger threshold.
# Applied universally (compose.yaml default is now also 2, so every profile,
# MTP-enabled or not, is capped) until the upstream bug is fixed. This explicit
# value keeps the cap visible/overridable here; do not raise without resolving
# #35288.
VLLM_MAX_NUM_SEQS=2
