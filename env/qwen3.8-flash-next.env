# Qwen3.8-Flash-Next (qwen4_exp: ~125B main + ~51B n-gram PLE embedding
# table, ~6B active). Served by the vllm-qwen-flashnext service, which must
# be built from Dockerfile.flashnext (FLASHNEXT_VLLM_REF — the vLLM head
# carrying qwen4_exp support, vllm#53896).
#
# EXPERIMENTAL bring-up profile. Not part of the default `just up`.
#
# Memory plan (4x R9700 = 128 GiB):
#   - Weights: W4A16 (compressed-tensors INT4, group-128) quantizes the main
#     GEMM weights only -> ~66 GiB GPU-resident. The 51.2B n-gram PLE table
#     stays BF16 and lives in pinned HOST memory: VLLM_PLE_CPU_OFFLOAD=1
#     (local patch patches/vllm-flashnext/ple-cpu-offload-rocm.patch) — the
#     host needs ~110 GiB of free RAM.
#   - moe_intermediate_size=640 is not divisible by 128 at TP4 (640/4=160),
#     which the group-128 quant layout requires, hence
#     --enable-expert-parallel via VLLM_EXTRA_ARGS.
#   - MTP/spec-decode is intentionally OFF for bring-up (re-enable via
#     VLLM_SPEC_DECODE once the base run is clean).
VLLM_MODEL=aixiaoma/Qwen3.8-Flash-Next-W4A16
VLLM_TOKENIZER=aixiaoma/Qwen3.8-Flash-Next-W4A16
VLLM_SERVED_NAME=qwen3.8-flash-next
VLLM_TP=4
VLLM_GPU_MEM_UTIL=0.95
VLLM_KV_CACHE_DTYPE=bfloat16
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_BATCHED_TOKENS=8192
VLLM_MAX_NUM_SEQS=2
VLLM_PLE_CPU_OFFLOAD=1
VLLM_EXTRA_ARGS=--enable-expert-parallel
