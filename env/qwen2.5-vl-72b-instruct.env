# Vision-language profile for the `vllm-vision` service (select it with
# VISION_MODEL_PROFILE / `just --set vision_model`). ROCm/GPU environment comes
# from env/2xr9700.vllm.common; shared caps come from env/qwen3.6.env.common
# (max_num_seqs) and are overridden below where they don't fit this model.
VLLM_MODEL=Qwen/Qwen2.5-VL-72B-Instruct-AWQ
VLLM_TOKENIZER=Qwen/Qwen2.5-VL-72B-Instruct-AWQ
VLLM_SERVED_NAME=Qwen2.5-VL-72B-Instruct-AWQ
VLLM_QUANTIZATION=awq
# 72B AWQ needs the whole box: this profile defaults to all four GPUs visible
# (env/2xr9700.vllm.common) with -tp 4. When running it alongside the main
# `vllm` container, restrict each to a non-overlapping GPU pair at runtime and
# drop VLLM_TP to 2.
VLLM_TP=4
VLLM_GPU_MEM_UTIL=0.42
VLLM_MAX_MODEL_LEN=16384
# Smaller batched-token budget: 256K-class contexts are irrelevant for a
# vision chat workload, and a smaller pool keeps prefill memory flat.
VLLM_MAX_BATCHED_TOKENS=4096
# No MTP heads on this model: override the qwen3.6 common MTP4 spec-decode.
VLLM_SPEC_DECODE=
# No qwen3_coder parser / qwen3.8 chat template apply to Qwen2.5-VL: the
# tokenizer's built-in template is used (entrypoint.sh omits --chat-template
# when VLLM_CHAT_TEMPLATE is unset) and only bare auto tool choice.
VLLM_TOOL_CHOICE='--enable-auto-tool-choice'
# bf16 KV is inherited from env/qwen3.6.env.common: no calibrated fp8 KV-scale
# copy exists for this model, so fp8 KV would serve at scale 1.0 (miscalibrated
# — see README.md). Opt back in with VLLM_KV_CACHE_DTYPE=fp8 if KV memory binds.
