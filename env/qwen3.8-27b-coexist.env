# Co-located variant of qwen3.8-27b: shrunk GPU pool so the flashnext W4
# RTN profile (qwen3.8-flash-next-w4rtng128-coexist) fits on the same 4 GPUs.
# 0.35 util = ~11.15 GiB/GPU budget. Measured live 2026-08-28: real weight+
# overhead footprint left only ~0.74 GiB/GPU of KV headroom (not the ~4.5 GiB
# assumed here originally) -> max_model_len cut to 24576 (est. ceiling was
# ~32448) to actually fit. Do NOT run the exclusive 0.53 profile alongside
# flashnext: the pools must sum under ~0.93 of VRAM.
VLLM_MODEL=Qwen/Qwen3.8-27B-FP8
VLLM_TOKENIZER=Qwen/Qwen3.8-27B-FP8
VLLM_SERVED_NAME=qwen3.8-27b
VLLM_TP=4
VLLM_GPU_MEM_UTIL=0.35
VLLM_MAX_MODEL_LEN=24576
VLLM_KV_CACHE_DTYPE=bfloat16
# 1 concurrent sequence while co-located (halves worst-case KV + the #35288
# MTP-corruption exposure surface).
VLLM_MAX_NUM_SEQS=1
# MTP3 spec-decode (same as the exclusive profile).
VLLM_SPEC_DECODE='{"method": "mtp", "num_speculative_tokens": 3, "attention_backend": "ROCM_AITER_UNIFIED_ATTN"}'
