# Model-specific config for Qwen/Qwen3.6-35B-A3B-FP8
VLLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
VLLM_TOKENIZER=Qwen/Qwen3.6-35B-A3B
VLLM_SERVED_NAME=qwen3.6-35b-a3b
VLLM_SPEC_DECODE='{"method": "mtp", "num_speculative_tokens": 4, "attention_backend": "ROCM_AITER_UNIFIED_ATTN"}'
VLLMM_MAX_BATCHED_TOKENS=4096
VLLM_KV_CACHE_DTYPE=fp8
VLLM_TOOL_CHOICE='--enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser qwen3'
