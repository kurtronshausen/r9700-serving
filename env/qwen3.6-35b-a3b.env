# Model-specific config for Qwen3.6-35B-A3B-FP8 — shares kv_cache_dtype, tool_choice
# via env/qwen3.6.env.common.
# MTP4 spec-decode is overridden below because vLLM native MTP with Qwen3-MoE
# produces garbled/degenerate token loops (see README "MTP workaround").
VLLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
VLLM_TOKENIZER=Qwen/Qwen3.6-35B-A3B
VLLM_SERVED_NAME=qwen3.6-35b-a3b
# MoE gated-delta layers force an attention block size of 2112 tokens.
VLLM_MAX_BATCHED_TOKENS=4096
# Disable MTP: native MTP spec-decode degenerates into token loops on Qwen3-MoE.
# Workaround confirmed by vllm-project/vllm#47087.
VLLM_SPEC_DECODE=
