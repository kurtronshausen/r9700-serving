# Co-located variant of our RTN W4A16 G128 flashnext quant: runs on all 4
# GPUs alongside qwen3.8-27b-coexist (0.35 util). 0.58 util = ~18.9 GiB/GPU:
# 15.8 W4 weights + ~3 GiB KV/act. Context is cut to 8192 to keep the KV pool
# small; PLE table still lives in pinned host RAM (~102 GiB, VLLM_PLE_CPU_OFFLOAD=1).
# Requires the /srv/llm/kurt compose volume mount (2026-08-28) and patch-v2
# ple-cpu-offload in the flashnext image (ec99be9+).
# Run: FLASHNEXT_PROFILE=qwen3.8-flash-next-w4rtng128-coexist just up-flashnext
VLLM_MODEL=/srv/llm/kurt/flashnext-w4a16-rtng128
VLLM_TOKENIZER=/srv/llm/kurt/flashnext-w4a16-rtng128
VLLM_SERVED_NAME=qwen3.8-flash-next-w4rtng128
VLLM_TP=4
VLLM_GPU_MEM_UTIL=0.58
VLLM_KV_CACHE_DTYPE=bfloat16
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_BATCHED_TOKENS=4096
VLLM_MAX_NUM_SEQS=2
VLLM_PLE_CPU_OFFLOAD=1
# Unquoted + space-free JSON: compose strips quotes only at value start and
# the entrypoint word-splits VLLM_EXTRA_ARGS.
VLLM_EXTRA_ARGS=--enable-expert-parallel --compilation-config {"mode":0}
