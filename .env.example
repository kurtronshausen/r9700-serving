# Active model profile: selects env/${MODEL_PROFILE}.env
MODEL_PROFILE=qwen3.8-27b

# Host ports (compose defaults already apply; uncomment to override).
#PORT=8000
#FLASHNEXT_PORT=8001
#RADIANCE_PORT=8002

# vllm-radiance service (Qwen3.8-27B-FP8 via the prebuilt Docker Hub image
# stilldeadcode/vllm-radiance — NOT built by this repo, no VLLM_REF/patches
# apply). Pin here so upgrades are a one-line change; see compose.yaml for
# the full command/environment. Not intended to run concurrently with
# `vllm`/`vllm-qwen-flashnext`.
RADIANCE_VLLM_RADIANCE_TAG=0.9.3
#RADIANCE_TP=4
#RADIANCE_MAX_NUM_SEQS=8
#RADIANCE_MAX_MODEL_LEN=200000
#RADIANCE_GPU_UTIL=0.90
#RADIANCE_MAX_NUM_BATCHED_TOKENS=4096
#RADIANCE_MTP_NSPEC=8
#RADIANCE_HIP_VISIBLE_DEVICES=0,1,2,3

# vllm-mxfp4 service (tcclaviger/Qwen3.8-Flash-Next-MXFP4-FP8 via the prebuilt
# Docker Hub image tcclaviger/vllm — NOT built by this repo, no VLLM_REF or
# local patches apply). Same Qwen3.8-Flash-Next (qwen4_exp) family as
# `vllm-qwen-flashnext` but a community image with its own GDN/PLE kernels
# (CLAV_GDN, AITER off). The `dev` tag can serve this model, but `dev` is
# MUTABLE — it has been rebuilt under us before (2026-09-07 -> 2026-09-21), so
# this service is pinned to a digest instead. Resolve a candidate with
# `docker buildx imagetools inspect docker.io/tcclaviger/vllm:dev` and bump
# deliberately; see compose.yaml for the full command. This is the build the
# service was verified healthy on.
MXFP4_VLLM_REF=sha256:4fd57a9c7e313183ea973227fddcd30e4d6712581c0fa2954607a807d34693dc
#MXFP4_PORT=8003
#MXFP4_TP=4
#MXFP4_MAX_NUM_SEQS=16
#MXFP4_MAX_MODEL_LEN=262144
#MXFP4_GPU_UTIL=0.92
#MXFP4_MAX_NUM_BATCHED_TOKENS=4096
#MXFP4_HIP_VISIBLE_DEVICES=0,1,2,3

# vllm-gptq service (tcclaviger/Qwen3.8-Flash-Next-MXFP4-FP8-GPTQ, the "AA2"
# activation-aware build of the same model with an int6 PLE table — better
# PPL/top-1 than the checkpoint above). Separate service so switching
# checkpoints is a `just up-gptq`, not a compose edit + cache clear.
#
# Pinned to a VERSION TAG, not `latest`: as of 2026-09-21 `latest` still
# resolves to a 2026-09-14 build while 29.02.1 (identical to that day's `dev`)
# is 7 days newer. The older checkpoint cannot be served by this image and the
# GPTQ checkpoint cannot be served by the image above, so these two services
# do not share an image. Set GPTQ_VLLM_REF to a digest to freeze it.
GPTQ_VLLM_TAG=29.02.1
#GPTQ_VLLM_REF=sha256:8692dca9907afa0a970e1acaed2eabc81067f4b83edcca5fb26521e98555d35a
#GPTQ_MODEL_DIR=/srv/llm/tcclaviger/Qwen3.8-Flash-Next-MXFP4-FP8-GPTQ
#GPTQ_PORT=8004
#GPTQ_TP=4
# 262144 = the model's native context, and what every recipe bundled in the
# image runs. 524288 needs VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 in the vllm-gptq
# environment block too (newer images reject positions past
# max_position_embeddings), and halves max concurrency per request.
#GPTQ_MAX_MODEL_LEN=262144
#GPTQ_GPU_UTIL=0.97
#GPTQ_MAX_NUM_SEQS=16
#GPTQ_MAX_NUM_BATCHED_TOKENS=8192
#GPTQ_HIP_VISIBLE_DEVICES=0,1,2,3
# Sampling/graph knobs (defaults match the GPTQ model card's TP4 example;
# note temperature 0.8 here vs 1.0 for vllm-mxfp4):
#GPTQ_TEMPERATURE=0.8
#GPTQ_TOP_P=0.95
#GPTQ_TOP_K=40
#GPTQ_PRESENCE_PENALTY=1
#GPTQ_MAX_TOKENS=65536
#GPTQ_CUDAGRAPH_SIZES=[4,8,12,16,20,24,28,32]
#GPTQ_MAX_CUDAGRAPH_SIZE=32
# Driver-tuning env from the card example is intentionally NOT applied
# (present during the only amdgpu MES unrecoverable + failed GPU reset that
# hard-hung the host; absent from every config in the image's `--recipes`).
# It has no .env knob by design — uncomment one at a time in the vllm-gptq
# environment block in compose.yaml to A/B it.

# Container runs as this host user so cache dirs stay user-owned.
USER_UID=1000
USER_GID=1000

# Host render group gid for /dev/dri access (check with `getent group render`).
RENDER_GID=992

# Build version pins
ROCM_IMAGE=docker.io/rocm/dev-ubuntu-24.04:7.14.0-full
GPU_ARCH=gfx1201
MAX_JOBS=16
TORCH_VERSION=2.13.0+rocm7.14.0
TORCHVISION_VERSION=0.28.0+rocm7.14.0
# VLLM_REF and VLLM_VERSION can be a git tag, branch, or commit hash.
VLLM_REF=v0.28.1rc0
VLLM_VERSION=0.28.1rc0
# Flash-Next build (Dockerfile.flashnext, vllm-qwen-flashnext service):
# newer vLLM head carrying qwen4_exp (vllm#53896) + local PLE CPU-offload
# patch. Kept separate from VLLM_REF so the main 27b image never rebuilds.
# Bumped 2a4cd640 -> fb97542c (2026-08-30): picks up e84efdeef1 (TP-replicated
# PLE conv state gets its own KV-cache group, fixing incorrect grouping for
# our exact arch) and e77c551c27 (fixes an assert crash in
# truncate_computed_blocks for non-prefix-cacheable scratch groups under
# --enable-prefix-caching, which we always run).
# Bumped fb97542c -> d750ca1 (2026-08-30, same day): picks up
# d750ca17f5a8 "Fix hybrid cache regressions across model runners", which
# makes _mamba_block_aligned_split stop chunks on the Mamba group's own
# state block size instead of the generic cache_config.block_size minimum --
# a state-poisoning-class prefix-cache bug (see upstream #54076) matching
# the reasoning-loop/repetition symptom seen at high prefix-cache-hit-rate
# under MTP. All 4 patches (incl. ple-cpu-offload-rocm.patch) applied clean
# against this head, no further rebase needed.
FLASHNEXT_VLLM_REF=d750ca17f5a842009ebba150990bb769890b7b0c
FLASHNEXT_VLLM_VERSION=0.28.1.dev0
AITER_REF=v0.1.20
# Flash Attention pinned to a specific commit.
FLASH_ATTN_REF=1cc7ff67cbc5685046c75183e8defecca3e35d5c
