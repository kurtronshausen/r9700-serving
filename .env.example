# Active model profile: selects env/${MODEL_PROFILE}.env
MODEL_PROFILE=qwen3.8-27b

# Host ports (compose defaults already apply; uncomment to override).
#PORT=8000
#FLASHNEXT_PORT=8001
#RADIANCE_PORT=8002
#RADIANCE_ENGINE_PORT=8007

# vllm-radiance service (Qwen3.8-27B-FP8 via the prebuilt Docker Hub image
# stilldeadcode/vllm-radiance — NOT built by this repo, no VLLM_REF/patches
# apply). Pin here so upgrades are a one-line change; see compose.yaml for
# the full command/environment. Not intended to run concurrently with
# `vllm`/`vllm-qwen-flashnext`.
RADIANCE_VLLM_RADIANCE_TAG=0.9.3
#RADIANCE_TP=4
#RADIANCE_MAX_NUM_SEQS=8
#RADIANCE_MAX_MODEL_LEN=200000
#RADIANCE_GPU_UTIL=0.90
#RADIANCE_MAX_NUM_BATCHED_TOKENS=4096
#RADIANCE_MTP_NSPEC=8
#RADIANCE_HIP_VISIBLE_DEVICES=0,1,2,3

# vllm-mxfp4 service (tcclaviger/Qwen3.8-Flash-Next-MXFP4-FP8 via the prebuilt
# Docker Hub image tcclaviger/vllm — NOT built by this repo, no VLLM_REF or
# local patches apply). Same Qwen3.8-Flash-Next (qwen4_exp) family as
# `vllm-qwen-flashnext` but a community image with its own GDN/PLE kernels
# (CLAV_GDN, AITER off). The `dev` tag can serve this model, but `dev` is
# MUTABLE — it has been rebuilt under us before (2026-09-07 -> 2026-09-21), so
# this service is pinned to a digest instead. Resolve a candidate with
# `docker buildx imagetools inspect docker.io/tcclaviger/vllm:dev` and bump
# deliberately; see compose.yaml for the full command. This is the build the
# service was verified healthy on.
MXFP4_VLLM_REF=sha256:4fd57a9c7e313183ea973227fddcd30e4d6712581c0fa2954607a807d34693dc
#MXFP4_PORT=8003
#MXFP4_TP=4
#MXFP4_MAX_NUM_SEQS=16
#MXFP4_MAX_MODEL_LEN=262144
#MXFP4_GPU_UTIL=0.92
#MXFP4_MAX_NUM_BATCHED_TOKENS=4096
#MXFP4_HIP_VISIBLE_DEVICES=0,1,2,3

# vllm-gptq service (tcclaviger/Qwen3.8-Flash-Next-MXFP4-FP8-GPTQ, the "AA2"
# activation-aware build of the same model with an int6 PLE table — better
# PPL/top-1 than the checkpoint above). Separate service so switching
# checkpoints is a `just up-gptq`, not a compose edit + cache clear.
#
# Pinned to 29.02.1 on purpose: this service uses VLLM_PLE_CPU_OFFLOAD, whose
# cudaHostRegister path fails on this RDNA4/ROCm box in the 29.04.9-era images
# (registers 0 bytes -> workers die). 29.02.1 pins via the ROCr VMM path that
# works here. To run a newer image, use vllm-gptq-aa below instead of bumping
# this tag. Use an explicit version tag, never `latest`/`dev` (mutable).
GPTQ_VLLM_TAG=29.02.1
#GPTQ_MODEL_DIR=/srv/llm/tcclaviger/Qwen3.8-Flash-Next-MXFP4-FP8-GPTQ
#GPTQ_PORT=8004
#GPTQ_TP=4
# 262144 = the model's native context, and what every recipe bundled in the
# image runs. 524288 needs VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 in the vllm-gptq
# environment block too (newer images reject positions past
# max_position_embeddings), and halves max concurrency per request.
#GPTQ_MAX_MODEL_LEN=262144
# 0.92 (not the card example's 0.97): vLLM reserves KV as util*VRAM minus
# weights only, so 0.97 left no room for the activation+graph footprint and a
# large-context prefill OOM'd. 0.92 fits weights+KV+act+graphs under free VRAM.
#GPTQ_GPU_UTIL=0.92
# (Do NOT add PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True — it breaks
# the PLE CPU-offload ROCr IPC export; see the vllm-gptq environment comment.)
#GPTQ_MAX_NUM_SEQS=16
#GPTQ_MAX_NUM_BATCHED_TOKENS=8192
#GPTQ_HIP_VISIBLE_DEVICES=0,1,2,3
# Sampling/graph knobs (defaults match the GPTQ model card's TP4 example;
# note temperature 0.8 here vs 1.0 for vllm-mxfp4):
#GPTQ_TEMPERATURE=0.8
#GPTQ_TOP_P=0.95
#GPTQ_TOP_K=40
#GPTQ_PRESENCE_PENALTY=1
#GPTQ_MAX_TOKENS=65536
#GPTQ_CUDAGRAPH_SIZES=[4,8,12,16,20,24,28,32]
#GPTQ_MAX_CUDAGRAPH_SIZE=32
# Driver-tuning env from the card example is intentionally NOT applied
# (present during the only amdgpu MES unrecoverable + failed GPU reset that
# hard-hung the host; absent from every config in the image's `--recipes`).
# It has no .env knob by design — uncomment one at a time in the vllm-gptq
# environment block in compose.yaml to A/B it.

# vllm-gptq-aa service: tcclaviger's own TP4 recipe for the "AA2" GPTQ build,
# reproduced as faithfully as possible on his current image, so issues can be
# quoted back to him verbatim. VLLM_PLE_CPU_OFFLOAD no longer exists in this
# image -- placement is the --engram-config default (cpu_offload=true = pinned
# host RAM), but that default pins via cudaHostRegister, which registers 0 bytes
# on this host and crashes. So we run --ple-nvme-offload (+ --ple-cache-reuse):
# the PLE table comes from NVMe with a small RAM row cache, bypassing
# cudaHostRegister. Other differences from vllm-gptq: max-model-len 524288 via a
# raised max_position_embeddings, cudagraph size [5], MTP 4 tokens, temp 0.6/
# top_k 20, and a chat-template override (qwen.jinja) to dodge the high-
# reasoning-effort bug. See the compose service comment for every deviation.
QFN_AA_VLLM_TAG=29.04.15
#QFN_AA_MODEL_DIR=/srv/llm/tcclaviger/Qwen3.8-Flash-Next-MXFP4-FP8-GPTQ-AA2
#QFN_AA_PORT=8006
#QFN_AA_TP=4
#QFN_AA_MAX_MODEL_LEN=524288
# 0.92 (not his 0.97): vLLM sizes the KV pool as util*VRAM minus weights only,
# ignoring activations + cudagraphs, so 0.97 left no headroom and the first
# large prefill OOM'd. Same fix as GPTQ_GPU_UTIL above.
#QFN_AA_GPU_UTIL=0.92
#QFN_AA_MAX_NUM_SEQS=16
#QFN_AA_MAX_NUM_BATCHED_TOKENS=8192
#QFN_AA_HIP_VISIBLE_DEVICES=0,1,2,3
#QFN_AA_OMP_NUM_THREADS=8
# Driver env (GPU_MAX_HW_QUEUES=1 / HSA_ENABLE_INTERRUPT=1 / HSA_ENABLE_MWAITX=1)
# is ENABLED in compose.yaml for the exact reproduction. GPU_MAX_HW_QUEUES=1 is
# also set by the main vllm/vllm-qwen-flashnext services; the HSA_ENABLE_* pair
# is not set by any other service here, and this trio is what the box coincided
# with during the only amdgpu MES hard-hang (the responsible variable was never
# isolated). If bringup hangs the host, a hard reboot clears it and the fix is to
# comment the trio back out.

# vllm-radiance-engine service: the radiance ENGINE (stilldeadcode/radiance,
# codeberg.org/StillDeadcode/radiance) serving
# StillDeadcode/qwen3.8-next-flash-fp8-iq4r-moe -- a 113.6 GiB .rad container,
# NOT a HuggingFace safetensors checkpoint and NOT vLLM. This is a different
# image from `vllm-radiance`'s stilldeadcode/vllm-radiance (which is vLLM + R4D
# kernels on the 27B). No VLLM_REF/AITER/patches apply; nothing here rebuilds.
#
# Pin an explicit version tag. `latest` and `1.4.0` are the same digest as of
# this writing (sha256:51b3fdfd...), but `latest` is mutable -- check with
#   docker buildx imagetools inspect docker.io/stilldeadcode/radiance:1.4.0
# and bump deliberately. The host needs no ROCm, only an amdgpu driver that
# supports ROCm 10.1, plus Resizable BAR / Above 4G Decoding in the firmware.
RADIANCE_ENGINE_TAG=1.16.0
# Prefill/decode pacing for the radiance engine (see compose.yaml notes).
# 0 restores every-step-carries-a-chunk; auto/off are also valid for BUSY_PREFILL_CHUNK.
RADIANCE_ENGINE_PREFILL_INTERLEAVE=8
RADIANCE_ENGINE_BUSY_PREFILL_CHUNK=1024
#RADIANCE_ENGINE_PORT=8007
#RADIANCE_ENGINE_SERVED_NAME=qwen3.8-flash-next-rad
#RADIANCE_ENGINE_TP=4
# `exact` is upstream's 4-rank row. `wht6` is a LOSSY wire: rotated 6-bit at 2
# ranks, tiered int8 at 3-4, refused at 8. A/B it on purpose, not by accident.
#RADIANCE_ENGINE_TP_WIRE=exact
#RADIANCE_ENGINE_P2P=auto
# --- Context ceiling and YaRN ---
# The container trains at 262144; YaRN factor 2 reaches exactly 524288, applied
# at load time (no reconversion). docs/YARN.md validates both Flash-Next
# variants at factor 2 with retrieval ~500K -- keep the factor, that is where
# upstream's numbers were measured. The serving ceiling is a separate knob:
# since 2026-11-03 it sits at the trained length, because worst-case KV at
# 8x524288 ~= 31 GiB/card (fp8, ~29 KiB/token) ate ~89% of the VRAM elastic
# region and demoted experts to the host/disk tiers -- while the largest
# measured real workload here is ~112k ctx. 262144 hands that VRAM back to
# expert residency. No on-disk prefix cache needs clearing when changing the
# factor (the disk tier was removed in v1.5.0; KV lives in VRAM + pinned RAM).
#RADIANCE_ENGINE_YARN_FACTOR=2
#RADIANCE_ENGINE_ROPE_ORIG=262144
RADIANCE_ENGINE_MAX_MODEL_LEN=262144
# 8, not upstream's 32: hybrid model, so each sequence carries its own recurrent
# state and 32 of them steal it from the attention cache + expert slab.
#RADIANCE_ENGINE_MAX_NUM_SEQS=8
# Where a prefix hit resumes: exact (default) only at chunk boundaries, so hits
# get cut short -- the 2026-11-03 boot logged ~1.46M tokens of re-prefill from
# exact-mode truncation (prefix_hit_cut_tokens). nearest resumes at the deepest
# snapshot; costs bit-identity vs a cold run, wins the re-prefill back.
RADIANCE_ENGINE_PREFIX_RESUME=nearest
#RADIANCE_ENGINE_MAX_NUM_BATCHED_TOKENS=2048
#RADIANCE_ENGINE_KV_DTYPE=fp8
#RADIANCE_ENGINE_PLACEMENT=expert_tiered
# Pinned on EVERY card: 4 ranks x 12288 MiB = 48 GiB of host RAM (memlock -1 is
# set in compose.yaml; the host's docker default of 8 MiB would cap it silently).
# Upstream warns the elastic expert window is a different shape above 2 ranks --
# read the boot log's `elastic` line and re-derive this before trusting it.
#RADIANCE_ENGINE_HOST_POOL_MIB=12288
#RADIANCE_ENGINE_GPU_HEADROOM_MIB=96
# 47.7 GiB n-gram PLE table: auto (vram -> ram -> disk) | vram | ram | disk.
#RADIANCE_ENGINE_NGRAM_PLACEMENT=auto
#RADIANCE_ENGINE_NUM_SPEC_TOKENS=3
# Prefix cache is two-tier since v1.5.0 (VRAM -> host RAM). The disk tier was
# removed upstream: it rewrote every block per prompt, never survived the
# process, and its flags (--prefix-cache-dir/-disk-mib) now fail the boot.
# --prefix-cache-host-mib was renamed --prefix-cache-mib. 4096 MiB ~= 143k
# parked tokens of conversation KV; the boot log recomputes if you change it.
#RADIANCE_ENGINE_PREFIX_CACHE_MIB=4096
# Writable state root (mounted at /data). Must be owned by USER_UID.
#RADIANCE_ENGINE_STATE=/srv/llm/radiance
# Mirrors the presence_penalty=1.0 mitigation the other Flash-Next services
# carry for the reasoning-loop issue. Set empty to use the engine's default.
#RADIANCE_ENGINE_PRESENCE_PENALTY=1.0
# The .rad itself (113.6 GiB) is NOT a build pin and has no knob here; it lives
# at /srv/llm/StillDeadcode/qwen3.8-next-flash-fp8-iq4r-moe.rad, referenced
# directly in compose.yaml. Download it with `just get-radiance-rad`.

# image-gen service (Qwen/Qwen-Image-2.1, a text-to-image / image-editing
# DIFFUSION model served via diffusers -- NOT vLLM, no KV cache). Built by
# Dockerfile.imagegen (its own image, shares only the ROCm/torch base). The
# ~32 GB of weights fill one R9700 and the default placement shards them over
# all four GPUs, so like every other service it runs one-at-a-time -- stop the
# LLM first. See the gfx1201 caveat in compose.yaml before debugging a bad boot.
#IMAGEGEN_MODEL_DIR=/srv/llm/Qwen/Qwen-Image-2.1
#IMAGEGEN_PORT=8005
# Placement: device_map (all GPUs, fastest) | cpu_offload (1 GPU + host RAM)
#   | sequential (1 GPU, slowest, most robust). Try sequential if device_map
#   faults on gfx1201.
#IMAGEGEN_OFFLOAD=device_map
# bfloat16 | float32. float32 is the documented fallback if bf16 kernels are
# missing on RDNA4 (produces NaN/garbage or faults).
#IMAGEGEN_DTYPE=bfloat16
#IMAGEGEN_HIP_VISIBLE_DEVICES=0,1,2,3

# Container runs as this host user so cache dirs stay user-owned.
USER_UID=1000
USER_GID=1000

# Host render group gid for /dev/dri access (check with `getent group render`).
RENDER_GID=992

# Build version pins
ROCM_IMAGE=docker.io/rocm/dev-ubuntu-24.04:7.14.0-full
GPU_ARCH=gfx1201
MAX_JOBS=16
TORCH_VERSION=2.13.0+rocm7.14.0
TORCHVISION_VERSION=0.28.0+rocm7.14.0
# VLLM_REF and VLLM_VERSION can be a git tag, branch, or commit hash.
VLLM_REF=v0.28.1rc0
VLLM_VERSION=0.28.1rc0
# image-gen build (Dockerfile.imagegen). diffusers is pinned to a git commit,
# NOT a version: QwenImage21Pipeline landed on main 2026-09-18 (this SHA),
# after the last release tag v0.40.0 (2026-08-20), so no released diffusers
# has the class yet. Switch to a version tag once one ships that carries it.
DIFFUSERS_REF=6256aa7666cedd47443adc8f82da9a10e110b09c
# transformers must carry Qwen3VLForConditionalGeneration + Qwen3VLProcessor
# (the pipeline's text encoder); present since the 4.57 line, pinned to latest.
TRANSFORMERS_VERSION=5.17.0
# Flash-Next build (Dockerfile.flashnext, vllm-qwen-flashnext service):
# newer vLLM head carrying qwen4_exp (vllm#53896) + local PLE CPU-offload
# patch. Kept separate from VLLM_REF so the main 27b image never rebuilds.
# Bumped 2a4cd640 -> fb97542c (2026-08-30): picks up e84efdeef1 (TP-replicated
# PLE conv state gets its own KV-cache group, fixing incorrect grouping for
# our exact arch) and e77c551c27 (fixes an assert crash in
# truncate_computed_blocks for non-prefix-cacheable scratch groups under
# --enable-prefix-caching, which we always run).
# Bumped fb97542c -> d750ca1 (2026-08-30, same day): picks up
# d750ca17f5a8 "Fix hybrid cache regressions across model runners", which
# makes _mamba_block_aligned_split stop chunks on the Mamba group's own
# state block size instead of the generic cache_config.block_size minimum --
# a state-poisoning-class prefix-cache bug (see upstream #54076) matching
# the reasoning-loop/repetition symptom seen at high prefix-cache-hit-rate
# under MTP. All 4 patches (incl. ple-cpu-offload-rocm.patch) applied clean
# against this head, no further rebase needed.
FLASHNEXT_VLLM_REF=d750ca17f5a842009ebba150990bb769890b7b0c
FLASHNEXT_VLLM_VERSION=0.28.1.dev0
AITER_REF=v0.1.20
# Flash Attention pinned to a specific commit.
FLASH_ATTN_REF=1cc7ff67cbc5685046c75183e8defecca3e35d5c
