# Active model profile: selects env/${MODEL_PROFILE}.env
MODEL_PROFILE=qwen3.6-27b

# Container runs as this host user so cache dirs stay user-owned.
USER_UID=1000
USER_GID=1000

# Build version pins
ROCM_IMAGE=docker.io/rocm/dev-ubuntu-24.04:7.14.0-full
GPU_ARCH=gfx1201
MAX_JOBS=16
TORCH_VERSION=2.13.0+rocm7.14.0
TORCHVISION_VERSION=0.28.0+rocm7.14.0
# VLLM_REF and VLLM_VERSION can be a git tag, branch, or commit hash.
VLLM_REF=v0.27.1
VLLM_VERSION=0.27.1
AITER_REF=v0.1.19.post2
# Flash Attention pinned to a specific commit.
FLASH_ATTN_REF=1cc7ff67cbc5685046c75183e8defecca3e35d5c
